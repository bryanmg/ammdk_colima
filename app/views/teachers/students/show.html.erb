<% if @attendances.empty? %>
  <div class="notification is-danger" style="margin-bottom: 0rem">
    <button class="delete"></button>
    <p><%= I18n.t('teachers.students.no_attendances') %></p>
  </div>
<% end %>

<div id="students" class="container">
  <%# General student information %>
  <br>
  <span class="title"><%= I18n.t('teachers.students.student_info') %></span>
  <br><br>
  <%= render "teachers/students/full_student", student: @student %>

  <%# Student record attendance %>
  <h2 class="subtitle is-flex is-justify-content-center">
    <strong><%= I18n.t('teachers.students.attendance_record') %></strong>
  </h2>
  <%= render "students/attendances/attendance_stats", attendance_stats: @attendance_stats %>
  <div class="container mb-5">
    <table class="table is-bordered is-narrow is-hoverable is-fullwidth">
      <thead>
        <tr class="has-background-primary-light">
          <th><%= I18n.t('teachers.students.attendance_date') %></th>
          <th><%= I18n.t('teachers.students.attendance_status') %></th>
        </tr>
      </thead>
      <tbody>
        <% @attendances.each do |attendance| %>
          <tr>
            <%= render "students/attendances/attendance", attendance: attendance %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Student record of learning resources %>
  <h2 class="subtitle is-flex is-justify-content-center">
    <strong><%= I18n.t('teachers.students.assigned_learning_resources') %></strong>
  </h2>
  <div class="container mb-5">
    <table class="table is-bordered is-narrow is-hoverable is-fullwidth">
      <thead>
        <tr class="has-background-primary-light">
          <th><%= I18n.t('teachers.students.learning_resource_name') %></th>
          <th><%= I18n.t('teachers.students.assigned_to') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @student.student_learning_resources.each do |resource| %>
          <tr>
            <td><%= resource.learning_resource.name %></td>
            <td><%= resource.learning_resource.created_at.strftime('%Y-%m-%d %T') %></td>
            <td class="is-flex is-justify-content-center">
              <%= button_to(teacher_student_learning_resource_path(@user, resource), class: "button is-info is-outlined is-small", method: :delete, data: { confirm: I18n.t('teachers.students.unassign_resource_confirmation') }) do %>
                <i class="far fa-trash-alt"></i>
                <span class="ml-2"><%= I18n.t('teachers.students.unassign') %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Student reviews made %>
  <h2 class="subtitle is-flex is-justify-content-center">
    <strong><%= I18n.t('teachers.students.student_review') %></strong>
  </h2>
  <div class="container mb-5">
    <table class="table is-bordered is-narrow is-hoverable is-fullwidth">
      <thead>
        <tr class="has-background-primary-light">
          <th><%= I18n.t('teachers.students.review') %></th>
          <th><%= I18n.t('teachers.students.reviewed_at') %></th>
          <th><%= I18n.t('teachers.students.learning_resource') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @student.reviews.each do |review| %>
          <tr>
            <td><%= review.review %></td>
            <td><%= review.created_at.strftime('%Y-%m-%d %T') %></td>
            <td><%= review.learning_resource&.name %></td>
            <td class="is-flex is-justify-content-center">
              <%= button_to(teacher_review_path(@user, review), class: "button is-info is-outlined is-small", method: :delete, data: { confirm: I18n.t('teachers.students.finish_review_confirmation') }) do %>
                <i class="far fa-trash-alt"></i>
                <span class="ml-2"><%= I18n.t('teachers.students.finish_review') %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <%# Searcher of student attendances %>
  <span class="subtitle mb-5">
    <strong><%= I18n.t('teachers.students.search_attendance') %></strong>
  </span>
  <br><br>
  <%= render "students/attendances/attendance_records_form", url: teacher_student_path(@user, @student) %>

  <%# Action bottom buttons %>
  <div class="is-flex is-justify-content-flex-end mt-5">
    <%= button_to(teacher_student_path(@user, @student), class: "button is-danger is-outlined mr-5", method: :delete, data: { confirm: I18n.t('teachers.students.delete_student_confirmation') } ) do %>
      <i class="far fa-trash-alt"></i>
      <span class="ml-2"><%= I18n.t('teachers.students.delete_student') %></span>
    <% end %>
    <%= button_to(teacher_student_path(@user, @student), class: "button is-warning is-outlined mr-5", method: :patch, params: {user: {password: @student[:birth_date].strftime('%d%m%y')}}, data: { confirm: I18n.t('teachers.students.reset_password_confirmation') }) do %>
      <i class="fas fa-unlock-alt"></i>
      <span class="ml-2"><%= I18n.t('teachers.students.reset_password') %></span>
    <% end %>
    <%= button_to(teacher_student_path(@user, @student), class: "button is-primary is-outlined mr-5", method: :patch, params: {user: {belt: promote_belt(@student[:belt]) }}, data: { confirm: I18n.t('teachers.students.promote_belt_confirmation') }) do %>
      <i class="far fa-caret-square-up"></i>
      <span class="ml-2"><%= I18n.t('teachers.students.promote_belt') %></span>
    <% end %>
    <%= link_to(edit_teacher_student_url(@user, @student), class: "button is-primary is-outlined mr-5") do %>
      <i class="fas fa-user-edit"></i>
      <span class="ml-2"><%= I18n.t('teachers.students.edit_student') %></span>
    <% end %>
    <%= link_to(teacher_students_url(@user), class: "button is-info is-outlined") do %>
      <i class="fas fa-undo"></i>
      <span class="ml-2"><%= I18n.t('teachers.students.back') %></span>
    <% end %>
  </div>
  <br>

</div>
