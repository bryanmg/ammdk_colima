<div id="<%= dom_id group %>">
  <p>
    <strong><%= t('teachers.groups.show.name') %>:</strong>
    <%= group.name %>
  </p>

  <p>
    <strong><%= t('teachers.groups.show.from') %>:</strong>
    <%= group.from_time.strftime('%k:%M:%S') %>
    <strong><%= t('teachers.groups.show.to') %>:</strong>
    <%= group.to_time.strftime('%k:%M:%S') %>
  </p>

  <p>
    <strong><%= t('teachers.groups.show.enrolled_students') %>:</strong>
    <%= group.group_members.count %>
  </p>

  <p>
    <strong><%= t('teachers.groups.show.training_days') %>:</strong>
    <%= render "teachers/groups/days_of_the_week", days_of_the_week: [] %>
  </p>
</div>
