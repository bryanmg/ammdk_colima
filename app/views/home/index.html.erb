<section class="hero is-success is-fullheight">

  <div class="hero-body">
    <div class="container has-text-centered">
        <%= image_tag "kwan_gi.png", alt: "AMDK logo", size:"300x300" %>
      <h1 class="title">Asoc. Mex. M.D.K</h1>
      <p class="subtitle">M.D.K. Occidente</p>

      <span class="icon-text">
        <span class="icon">
          <i class="fas fa-sign-in-alt"></i>
        </span>
        <span>
          <% if user_signed_in?
              if current_user.teacher?%>
                <%= link_to I18n.t('log_in.to_dashboard'), teacher_path(current_user) %>
              <% else  %>
                <%= link_to I18n.t('log_in.to_dashboard'), student_path(current_user) %>
              <% end  %>
          <% else  %>
            <%= link_to I18n.t('log_in.log_in'), new_user_session_path %>
            <%= I18n.t('log_in.to_continue') %>
          <% end  %>
        </span>
      </span>
    </div>
  </div>
</section>

