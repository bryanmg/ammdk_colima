<div id="<%= dom_id student %>">
  <div class="columns">
    <div class="column">
      <div class="box">
        <h2 class="subtitle"><%= t('students.personal_data') %></h2>
        <p>
          <strong><%= t('students.name') %>:</strong>
          <%= student.name %>
        </p>

        <p>
          <strong><%= t('students.belt') %>:</strong>
          <%= BELTS_TEXT[student.belt.to_sym] %>
        </p>

        <p>
          <strong><%= t('students.group') %>:</strong>
          <%= student.group_member&.group&.name %>
        </p>

        <p>
          <strong><%= t('students.ocupation') %>:</strong>
          <%= student.student_information&.ocupation %>
        </p>

        <p>
          <strong><%= t('students.monthly_payment') %>:</strong>
          <%= student.student_information&.montly_payment %>
        </p>
      </div>
    </div>
    <div class="column">
      <div class="box">
        <h2 class="subtitle"><%= t('students.responsible_legal_data') %></h2>
        <p>
          <strong><%= t('students.tutor') %>:</strong>
          <%= student.student_information&.tutor_name %>
        </p>

        <p>
          <strong><%= t('students.call_to') %>:</strong>
          <%= student.student_information&.cellphone %>
        </p>

        <p>
          <strong><%= t('students.social_security_number') %>:</strong>
          <%= student.student_information&.health_insurance %>
        </p>
        <br>
      </div>
    </div>
  </div>

  <br/>
</div>
