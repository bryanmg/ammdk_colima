<div class="container pt-5">
  <h1 class="title"><%= I18n.t('dashboard.title') %></h1>

  <% if @in_progress_group.present? %>
    <div class="content">
      <div class="notification is-info">
        <button class="delete"></button>
        <%= link_to I18n.t('dashboard.in_progress_group_link', group_name:@in_progress_group.name), new_teacher_group_attendance_url(@user, @in_progress_group) %>
      </div>
    </div>
  <% end %>

  <div class="content">
    <div class="columns ">
    
      <div class="column">
        <div class="box content is-medium">
          <div class="media">
            <div class="media-left">
              <span class="title"><%= @total_of_students %></span>
            </div>
            <div class="media-content">
              <i class="fas fa-users"></i>
              <%= link_to I18n.t('dashboard.students'), teacher_students_url(@user), class: "has-text-grey-darker"%>
            </div>
          </div>
        </div>
      </div>

      <div class="column">
        <div class="box content is-medium">
          <div class="media">
            <div class="media-left">
              <span class="title"><%= @user.groups.count %></span>
            </div>
            <div class="media-content">
              <i class="fas fa-user-clock"></i>
              <%= I18n.t('dashboard.groups') %>
            </div>
          </div>
        </div>
      </div>

      <div class="column">
        <div class="box content is-medium">
          <div class="media">
            <div class="media-left">
              <span class="title"><%= @user.learning_resources.all.count %></span>
            </div>
            <div class="media-content">
              <i class="fas fa-chalkboard-teacher"></i>
              <%= link_to I18n.t('dashboard.learning_resources'), teacher_learning_resources_url(@user), class: "has-text-grey-darker" %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <div class="content">
    <div class="columns is-mobile">
      <div class="column">
        <div class="buttons are-medium">
          <%= link_to I18n.t('dashboard.create_group'), new_teacher_group_url(@user), class: "button is-info is-outlined" %>
          <%= link_to I18n.t('dashboard.register_student'), new_teacher_student_url(@user), class: "button is-info is-outlined" %>
          <%= link_to I18n.t('dashboard.view_students'), teacher_students_url(@user), class: "button is-info is-outlined" %>
          <%= link_to I18n.t('dashboard.my_learning_resources'), teacher_learning_resources_url(@user), class: "button is-info is-outlined" %>
          <%= link_to I18n.t('dashboard.edit_profile'), edit_teacher_url(@user), class: "button is-info is-outlined" %>
          <%= link_to I18n.t('dashboard.assign_learning_resource'), new_teacher_student_learning_resource_url(@user), class: "button is-info is-outlined" %>
          <%= link_to I18n.t('dashboard.create_learning_resource'), new_teacher_learning_resource_url(@user), class: "button is-info is-outlined" %>
          <%= link_to I18n.t('dashboard.review_student'), new_teacher_review_url(@user), class: "button is-info is-outlined" %>
          <%= link_to I18n.t('dashboard.view_debts'), teacher_debts_url(@user), class: "button is-info is-outlined" %>
        </div>
      </div>
    </div>
  </div>

  <h2 class="title"><%= I18n.t('dashboard.my_groups') %></h2>
  <%= render 'groups', groups:@groups %>

  <br />
</div>
