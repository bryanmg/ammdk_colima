<div id="days of the week" class="">
  <% days_of_the_week.map do |day, value| %>
    <% if value == "1" %>
      <span class="tag is-info is-medium">
        <%= t("teachers.groups.days_of_the_week.#{day}") %>
        <i class="fas fa-check ml-2"></i> 
      </span>
    <% else %>
      <span class="tag is-light is-medium"><%= t("teachers.groups.days_of_the_week.#{day}") %></span>
    <% end %>
  <% end %>
</div>
