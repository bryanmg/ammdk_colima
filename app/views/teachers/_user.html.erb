<div id="<%= dom_id user %>">

  <p>
    <strong><%= I18n.t('user.name') %>:</strong>
    <%= user.name %>
  </p>

  <p>
    <strong><%= I18n.t('user.belt') %>:</strong>
    <%= BELTS_TEXT[BELTS.key(user.belt)] %>
  </p>

  <p>
    <strong><%= I18n.t('user.birth_date') %>:</strong>
    <%= user.birth_date %>
  </p>

  <p>
    <strong><%= I18n.t('user.email') %>:</strong>
    <%= user.email %>
  </p>
</div>
